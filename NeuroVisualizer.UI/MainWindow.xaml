<Window x:Class="NeuralVisualizer1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width ="1400"
        Height ="900">
    
    <StackPanel>
        <Label Content="NeuralVisualizer1" FontSize="24" FontWeight="Bold" Margin="10"/>
        <StackPanel Orientation="Horizontal" Margin="10">
            <Button Content="New Model" Width="100" Margin="5"
                    Click="NewModel_Click"/>
            <Button Content="Load Model" Width="100" Margin="5"
                    Click="LoadModel_Click"/>
            <Button Content="Train" Width="100" Margin="5"
                    Click="Train_Click"/>
        </StackPanel>
        <TextBlock Text="{Binding Loss, StringFormat=Loss: {0:F6}}"/>
        
      
        <TextBlock Text="{Binding Accuracy, StringFormat=Accuracy: {0:P0}}"/>
        
        
        <TextBlock Text="{Binding CurrentEpoch, StringFormat=Epoch: {0}}" />
        <TextBlock Text="{Binding TotalEpochsTrained, StringFormat=Total Epochs: {0}}" />
        <TextBlock Text="{Binding TrainingStatus, StringFormat=Status: {0}}" />


        <TextBlock Text="Epochs to train:"/>
        <TextBox Text="{Binding EpochsToTrain, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        <TextBlock Text="Learning rate:"/>
        <TextBox Text="{Binding LearningRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        <DataGrid x:Name ="PredictionRows" ItemsSource="{Binding PredictionRows}"/>
       <!--
        <TextBlock Text="Training History:" FontWeight="Bold" Margin="5"/>
        <DataGrid ItemsSource="{Binding LossHistory}" Height="150"/>
        -->
        <TextBlock Text="Live Loss Graph:" FontWeight="Bold" Margin="5"/>

        <Border BorderBrush="Red" BorderThickness="1" Margin="5" Height="300" HorizontalAlignment="Stretch">
            
            <Canvas x:Name="LossGraphCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            SizeChanged="LossGraphCanvas_SizeChanged"
            Background="Black"/>
        </Border>

        <TextBlock Text="Live Neural Network Activations:" FontWeight="Bold" Margin="5"/>

        <Border BorderBrush="Blue"
        BorderThickness="1"
        Margin="5"
        Height="550"
        HorizontalAlignment="Stretch">
            <Canvas x:Name="NetworkGraphCanvas"
            Background="Black"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            SizeChanged="NetworkGraphCanvas_SizeChanged"/>
        </Border>

        <TextBlock Text="Activation Values:" FontWeight="Bold" Margin="5"/>

        <StackPanel Orientation="Horizontal" Margin="5">

            <StackPanel Margin="10">
                <TextBlock Text="Input" FontWeight="Bold"/>
                <TextBlock Text="Input 1:"/>
                <TextBlock x:Name="Input1Value"/>
                <TextBlock Text="Input 2:"/>
                <TextBlock x:Name="Input2Value"/>
            </StackPanel>

            <StackPanel Margin="10">
                <TextBlock Text="Hidden 1" FontWeight="Bold"/>
                <TextBlock Text="H1-1:"/>
                <TextBlock x:Name="Hidden1_1Value"/>
                <TextBlock Text="H1-2:"/>
                <TextBlock x:Name="Hidden1_2Value"/>
                <TextBlock Text="H1-3:"/>
                <TextBlock x:Name="Hidden1_3Value"/>
                <TextBlock Text="H1-4:"/>
                <TextBlock x:Name="Hidden1_4Value"/>
            </StackPanel>

            <StackPanel Margin="10">
                <TextBlock Text="Hidden 2" FontWeight="Bold"/>
                <TextBlock Text="H2-1:"/>
                <TextBlock x:Name="Hidden2_1Value"/>
                <TextBlock Text="H2-2:"/>
                <TextBlock x:Name="Hidden2_2Value"/>
                <TextBlock Text="H2-3:"/>
                <TextBlock x:Name="Hidden2_3Value"/>
                <TextBlock Text="H2-4:"/>
                <TextBlock x:Name="Hidden2_4Value"/>
            </StackPanel>

            <StackPanel Margin="10">
                <TextBlock Text="Output" FontWeight="Bold"/>
                <TextBlock Text="Output:"/>
                <TextBlock x:Name="OutputValue"/>
            </StackPanel>

        </StackPanel>
    </StackPanel>
    </Window>