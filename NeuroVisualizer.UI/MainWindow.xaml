<Window x:Class="NeuralVisualizer1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuralVisualizer"
        Width="1400"
        Height="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <!-- ================= HEADER ================= -->
            <TextBlock Text="NeuralVisualizer"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="XOR Neural Network + MNIST Digit Recognition"
                       FontSize="16"
                       Foreground="Gray"
                       Margin="0,0,0,20"/>


            <!-- ================= CONTROL BUTTONS ================= -->
            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,15">

                <StackPanel>
                    <TextBlock Text="Model Controls"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Train MNIST"
                                Width="130"
                                Height="35"
                                Margin="5"
                                Click="TrainMnist_Click"/>
                        
                        <Button Content="Train MNIST By 1 Epoch"
                                Width="130"
                                Height="35"
                                Margin="5"
                                Click="TrainMnistOneEpoch_Click"/>


                            <Button Content="Draw MNIST Image"
                                Width="130"
                                Height="35"
                                Margin="5"
                                Click="DrawMnistImage_Click"/>

                    </StackPanel>
                </StackPanel>
            </Border>

            
            

            <!-- ================= TRAINING SETTINGS ================= -->
            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,15">

                <StackPanel>
                    <TextBlock Text="Training Settings"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal">

                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Epochs to Train:"/>
                            <TextBox Width="150"
                                     Text="{Binding EpochsToTrain, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Learning Rate:"/>
                            <TextBox Width="150"
                                     Text="{Binding LearningRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ================= CURRENT METRICS ================= -->
            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,15">

                <StackPanel>
                    <TextBlock Text="Training Metrics"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <UniformGrid Columns="5">

                        <StackPanel Margin="5">
                            <TextBlock Text="Loss" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Loss, StringFormat={}{0:F6}}"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="Accuracy" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Accuracy, StringFormat={}{0:P0}}"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="Current Epoch" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentEpoch}"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="Total Epochs" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalEpochsTrained}"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="Status" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TrainingStatus}"/>
                        </StackPanel>

                    </UniformGrid>
                </StackPanel>
            </Border>


            <!-- ================= MNIST TEST VIEWER ================= -->
            <Border BorderBrush="DarkOrange"
                    BorderThickness="2"
                    Padding="10"
                    Margin="0,0,0,15">

                <StackPanel>
                    <TextBlock Text="MNIST Digit Viewer"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal">

                        <!-- MNIST IMAGE -->
                        <StackPanel Margin="0,0,25,0">
                            <TextBlock Text="Input Image"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>

                            <Border BorderBrush="Black"
                                    BorderThickness="2"
                                    Width="280"
                                    Height="280"
                                    Background="Black">

                                <!-- We will draw the 28x28 digit here using code-behind -->
                                <Canvas x:Name="MnistImageCanvas"
                                        Width="280"
                                        Height="280"
                                        Background="Black"/>
                            </Border>
                        </StackPanel>


                        <!-- MNIST RESULT TEXT -->
                        <StackPanel Margin="0,0,25,0"
                                    Width="220">

                            <TextBlock Text="Prediction"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <TextBlock Text="Target Digit: "
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentMnistTargetDigit}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <TextBlock Text="Predicted Digit: "
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentMnistPredictedDigit}"/>
                            </StackPanel>

                        </StackPanel>


                        <!-- FUTURE OUTPUT NEURONS -->
                        <StackPanel Width="300">
                            <TextBlock Text="Output Neurons"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Later this section can show output[0] through output[9]."
                                       TextWrapping="Wrap"
                                       Foreground="Gray"/>

                            <TextBlock Text="The largest output value becomes the predicted digit."
                                       TextWrapping="Wrap"
                                       Foreground="Gray"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= LOSS GRAPH ================= -->
            <Border BorderBrush="Red"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,15">

                <StackPanel>
                    <TextBlock Text="Live Loss Graph"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <Canvas x:Name="LossGraphCanvas"
                            Height="300"
                            Background="Black"
                            HorizontalAlignment="Stretch"
                            SizeChanged="LossGraphCanvas_SizeChanged"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>